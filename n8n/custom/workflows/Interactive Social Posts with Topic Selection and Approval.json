    },
    {
      "parameters": {
        "functionCode": "// Build final text: prefer user edits from approval payload { approved, text }\nreturn items.map((item) => {\n  const postText = item[\"Input 1\"]?.json?.message?.content || item.json?.message?.content || '';\n  const approval = item[\"Input 2\"]?.json || {};\n  const approved = Boolean(approval.approved);\n  const finalText = (approval.text && String(approval.text).trim().length > 0) ? approval.text : postText;\n  return { json: { approved, finalText } };\n});"
      },
      "id": "9f7b3a26-1d67-4a66-9e0d-29b39c2ba5cc",
      "name": "Finalize Post Text",
