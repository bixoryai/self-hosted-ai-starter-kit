{
  "name": "Interactive Social Posts with Topic Selection and Approval",
  "nodes": [
    {
      "parameters": {
        "content": "Interactive flow:\n- Start at form: /form/social-topic-form (enter topic)\n- LLM returns 5 titles (JSON)\n- Pause: choose a title via Resume URL with {\"choice\":0..4}\n- Generate post + image\n- Pause: approve/edit via Resume URL with { approved: true, text?: string }\n- If approved: log to Google Sheets and post once to X/LinkedIn/Facebook.\n\nAssign credentials: OpenAI, Google Sheets, Twitter, LinkedIn, Facebook Graph API."
      },
      "id": "4f6a8d3b-5e2c-4a3b-9a1e-0c2d5f7a9b10",
      "name": "Workflow Notes",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        360,
        -220
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "path": "social-topic-form",
        "formTitle": "Daily Social Topic",
        "formDescription": "Enter today's general topic for the posts.",
        "fields": {
          "values": [
            {
              "fieldLabel": "Topic",
              "name": "topic",
              "fieldType": "string",
              "required": true
            }
          ]
        }
      },
      "id": "7e3c6a2a-8a5d-4aa5-b0d6-b3f8a4e7c201",
      "name": "Topic Input (Form)",
      "type": "n8n-nodes-base.formTrigger",
      "position": [
        360,
        -40
      ],
      "typeVersion": 1,
      "notesInFlow": true,
      "notes": "Open in browser: /form/social-topic-form. Submitting provides { topic } to the flow."
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "niche",
              "value": "automation"
            },
            {
              "name": "audience",
              "value": "solopreneurs"
            }
          ]
        },
        "options": {}
      },
      "id": "c8f8f9f0-7c7d-4b41-ae8b-7b4f8a3e9a22",
      "name": "Set Defaults",
      "type": "n8n-nodes-base.set",
      "position": [
        600,
        -40
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "chatgpt-4o-latest",
          "cachedResultName": "CHATGPT-4O-LATEST"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a helpful social media strategist. Based on the general topic: {{ $json.topic || ('a very specific problem in ' + $json.niche + ' for ' + $json.audience) }}, generate five distinct, attention-grabbing, 50-character titles. Return ONLY strict JSON in this shape: {\n  \"titles\": [\"title 1\", \"title 2\", \"title 3\", \"title 4\", \"title 5\"]\n}."
            }
          ]
        },
        "options": {}
      },
      "id": "a2a9f2bb-1c53-4d6b-a7da-1b2e7f2e9a33",
      "name": "Generate 5 Titles",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "position": [
        880,
        -40
      ],
      "typeVersion": 1.8,
      "credentials": {
        "openAiApi": {
          "id": "ldnnvH1AW74k83Fk",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Parse JSON returned by the LLM to extract titles array.\nconst itemsOut = [];\nfor (const item of items) {\n  const content = item.message?.content || '';\n  let parsed = { titles: [] };\n  try {\n    parsed = JSON.parse(content);\n  } catch (e) {\n    // fallback: attempt to extract lines\n    const maybe = content.split('\n').map(l => l.replace(/^-\\s*/, '').trim()).filter(Boolean).slice(0,5);\n    parsed.titles = maybe;\n  }\n  itemsOut.push({ json: { titles: parsed.titles } });\n}\nreturn itemsOut;"
      },
      "id": "7b4d6d3d-0a3f-4a5a-8b8a-0f1b2e3c4d55",
      "name": "Parse Titles JSON",
      "type": "n8n-nodes-base.function",
      "position": [
        1120,
        -40
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "resume": "webhook",
        "additionalFields": {}
      },
      "id": "2f9cda28-7e9f-4d9d-8e6d-2f69aa5b8b77",
      "name": "Wait for Title Selection",
      "type": "n8n-nodes-base.wait",
      "position": [
        1360,
        -40
      ],
      "typeVersion": 1,
      "notesInFlow": true,
      "notes": "Pause. Use the Resume URL and POST { \"choice\": 0..4 } to select a title."
    },
    {
      "parameters": {
        "mode": "combine"
      },
      "id": "8b2b2f83-5a57-4b2c-8f66-62b3b0a7d611",
      "name": "Merge Titles + Choice",
      "type": "n8n-nodes-base.merge",
      "position": [
        1600,
        -40
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "functionCode": "// Pick selected title by index from resume payload { choice: 0..4 }\nreturn items.map((item) => {\n  const titles = item.json.titles || item[\"Input 1\"]?.json?.titles || [];\n  const choice = item[\"Input 2\"]?.json?.choice ?? item.json.choice ?? 0;\n  const idx = Math.max(0, Math.min(4, Number(choice)));\n  const selectedTitle = titles[idx] || titles[0] || '';\n  return { json: { selectedTitle, titles } };\n});"
      },
      "id": "e0d4a1a1-42ab-4f0d-8c7e-9e9f0b3d7a21",
      "name": "Select Title",
      "type": "n8n-nodes-base.function",
      "position": [
        1840,
        -40
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "chatgpt-4o-latest",
          "cachedResultName": "CHATGPT-4O-LATEST"
        },
        "messages": {
          "values": [
            {
              "content": "=Write a concise, solution-oriented social post based on the title: \n\n\"{{ $json.selectedTitle }}\"\n\nUse simple language, add relevant hashtags, keep under 280 characters. Return only the text of the post."
            }
          ]
        },
        "options": {}
      },
      "id": "cf44a0e9-6ef1-4b13-8d98-ef6cd2e91b85",
      "name": "Generate Post Text",
