    {
      "parameters": {
        "jsCode": "// Parse JSON returned by the LLM to extract titles array\nconst itemsOut = [];\nfor (const item of $input.all()) {\n  const content = item.json.message?.content || '';\n  let parsed = { titles: [] };\n  try {\n    parsed = JSON.parse(content);\n  } catch (e) {\n    // fallback: attempt to extract lines\n    const maybe = content.split('\\n')\n      .map(l => l.replace(/^-\\s*/, '').trim())\n      .filter(Boolean)\n      .slice(0,5);\n    parsed.titles = maybe;\n  }\n  itemsOut.push({ json: { titles: parsed.titles } });\n}\nreturn itemsOut;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        160
      ],
      "id": "c7bb6f49-b5e7-48f1-b6a4-833c09008ded",
      "name": "Parse Titles JSON"
    },
    {
      "parameters": {
        "jsCode": "// Pick selected title from form submission\nconst items = $input.all();\nreturn items.map((item) => {\n  const titles = item.json.titles || [];\n  \n  // The form sends \"Choice\" (capital C) with the actual title text\n  const selectedTitle = item.json.Choice || item.json.choice || titles[0] || '';\n  \n  return { json: { selectedTitle, titles } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        80
      ],
      "id": "9e964757-7e73-4c0c-9f39-3cbaa354192d",
      "name": "Select Title"
    },
    {
      "parameters": {
        "jsCode": "// Build final text: prefer user edits from approval payload\nconst items = $input.all();\nreturn items.map((item) => {\n  // Get post text from current input (from Merge)\n  const postText = item.json?.message?.content || '';\n  \n  // Get approval data from current input (from Merge)\n  const approved = Boolean(item.json.approved || item.json.Approve === 'Approve' || item.json.Approve === 'true');\n  const userEdit = item.json.text || item.json.Modify || '';\n  const finalText = (userEdit && String(userEdit).trim().length > 0) \n    ? userEdit \n    : postText;\n  \n  // Get selectedTitle DIRECTLY from the Select Title node\n  const selectedTitle = $node[\"Select Title\"].json.selectedTitle || '';\n  \n  // Get image data from current input (passed through from Generate Image)\n  const imageUrl = item.json.url || '';\n  \n  return { \n    json: { \n      approved, \n      finalText,\n      selectedTitle,\n      imageUrl\n    },\n    // Pass through binary image data for LinkedIn\n    binary: item.binary || {}\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2416,
        48
      ],
