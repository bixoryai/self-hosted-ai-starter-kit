    {
      "parameters": {
        "jsCode": "// Completely separate parsing for each LLM provider\nconst itemsOut = [];\n\nfor (const item of $input.all()) {\n  let titles = [];\n  \n  // ANTHROPIC PARSING - content is an array\n  if (item.json.content && Array.isArray(item.json.content)) {\n    try {\n      // Anthropic: content[0].text with markdown wrapper\n      const text = item.json.content[0].text;\n      // Remove ```json and ``` markers\n      const cleanText = text.replace(/```json\\s*/gi, '').replace(/```\\s*$/g, '').trim();\n      const parsed = JSON.parse(cleanText);\n      titles = parsed.titles || [];\n    } catch (e) {\n      titles = ['Error parsing Anthropic response'];\n    }\n  }\n  // OLLAMA PARSING - content is a string (direct, not in message)\n  else if (item.json.content && typeof item.json.content === 'string') {\n    try {\n      // Ollama: content is a JSON string directly\n      const parsed = JSON.parse(item.json.content);\n      titles = parsed.titles || [];\n    } catch (e) {\n      titles = ['Error parsing Ollama response'];\n    }\n  }\n  // OPENAI PARSING - message.content is an object\n  else if (item.json.message?.content && typeof item.json.message.content === 'object') {\n    try {\n      // OpenAI: message.content is already an object with titles\n      titles = item.json.message.content.titles || [];\n    } catch (e) {\n      titles = ['Error parsing OpenAI response'];\n    }\n  }\n  // FALLBACK - check message.content as string (backup for Ollama)\n  else if (item.json.message?.content && typeof item.json.message.content === 'string') {\n    try {\n      const parsed = JSON.parse(item.json.message.content);\n      titles = parsed.titles || [];\n    } catch (e) {\n      titles = ['Error parsing message.content string'];\n    }\n  }\n  else {\n    titles = ['Error: Unknown response format'];\n  }\n  \n  itemsOut.push({ json: { titles: titles } });\n}\n\nreturn itemsOut;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        160
      ],
      "id": "c7bb6f49-b5e7-48f1-b6a4-833c09008ded",
      "name": "Parse Titles JSON"
    },
    {
      "parameters": {
        "jsCode": "// Pick selected title from form submission\nconst items = $input.all();\nreturn items.map((item) => {\n  const titles = item.json.titles || [];\n  \n  // The form sends \"Choice\" (capital C) with the actual title text\n  const selectedTitle = item.json.Choice || item.json.choice || titles[0] || '';\n  \n  return { \n    json: { \n      selectedTitle, \n      titles,\n      LLMProvider: item.json.LLMProvider\n    } \n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        176
      ],
      "id": "9e964757-7e73-4c0c-9f39-3cbaa354192d",
      "name": "Select Title"
    },
    {
      "parameters": {
        "jsCode": "// Build final text: prefer user edits from approval payload\nconst items = $input.all();\nreturn items.map((item) => {\n  // Get post text from current input (from Merge) - handle different formats\n  let postText = '';\n  \n  // Try Anthropic format first\n  if (item.json?.content && Array.isArray(item.json.content)) {\n    postText = item.json.content[0]?.text || '';\n  }\n  // Try OpenAI/Ollama format\n  else if (item.json?.message?.content) {\n    postText = item.json.message.content;\n  }\n  \n  // Get approval data from current input (from Merge)\n  const approved = Boolean(item.json.approved || item.json.Approve === 'Approve' || item.json.Approve === 'true');\n  const userEdit = item.json.text || item.json.Modify || '';\n  const finalText = (userEdit && String(userEdit).trim().length > 0) \n    ? userEdit \n    : postText;\n  \n  // Get selectedTitle DIRECTLY from the Select Title node\n  const selectedTitle = $node[\"Select Title\"].json.selectedTitle || '';\n  \n  // Get image data from current input (passed through from Generate Image)\n  const imageUrl = item.json.url || '';\n  \n  return { \n    json: { \n      approved, \n      finalText,\n      selectedTitle,\n      imageUrl\n    },\n    // Pass through binary image data for LinkedIn\n    binary: item.binary || {}\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
