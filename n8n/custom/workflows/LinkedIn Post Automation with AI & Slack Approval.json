    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a LinkedIn content expert. Create an engaging LinkedIn post based on this topic:\n\nTopic: {{ $json.post_title }}\n\nRequirements:\n1. Start with a compelling hook that grabs attention\n2. Include 3-4 informative paragraphs with valuable insights\n3. Add relevant emojis to increase engagement\n4. End with a thought-provoking question to encourage comments\n5. Include 4-6 trending hashtags related to the topic\n6. Use proper spacing and formatting for LinkedIn readability\n7. Keep it professional yet conversational\n8. Aim for 150-300 words\n\nMake it engaging, valuable, and likely to get interactions!",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an expert LinkedIn content creator who understands virality, engagement, and professional storytelling."
        }
      },
      "id": "908eee31-78eb-482c-b331-2d3467d56b0d",
      "name": "Linedin-Post-Creator",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [180, -180],
      "typeVersion": 1.9
    },
    {
      "parameters": {
        "jsCode": "// Format the LinkedIn post for Slack display\nconst post = $input.item.json.output?.post || $input.item.json.post || '';\n\n// Escape special characters for Slack\nconst escapedPost = post\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\n// Keep track of the post ID and image URL\nconst postId = $input.item.json.post_id || $input.item.json.ID;\nconst imageUrl = $input.item.json.image_url || $input.item.json['Image URL'] || '';\nconst postTitle = $input.item.json.post_title || $input.item.json['Linkedin Post Title'] || '';\n\nreturn {\n  json: {\n    formatted_post: escapedPost,\n    post_id: postId,\n    image_url: imageUrl,\n    post_title: postTitle,\n    original_post: post\n  }\n};"
      },
      "id": "882d6e5c-a7f0-425f-a501-1f7179f8857b",
      "name": "Format-Content",
      "type": "n8n-nodes-base.code",
      "position": [556, -180],
      "typeVersion": 2
    },
    {
      "parameters": {
        "select": "user",
        "user": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_USER_ID"
        },
        "text": "=📝 *New LinkedIn Post Ready for Review*\n\n*Topic:* {{ $json.post_title }}\n*Post ID:* {{ $json.post_id }}\n\n*Generated Content:*\n{{ $json.formatted_post }}\n\n{{ $json.image_url ? '*Image URL:* ' + $json.image_url : '*No image attached*' }}",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "actions",
              "blockId": "approval_actions_{{ $json.post_id }}",
              "elements": [
                {
                  "type": "button",
                  "text": "✅ Approve",
                  "actionId": "approve_post",
                  "style": "primary",
                  "value": "={{ $json.post_id }}"
                },
                {
                  "type": "button",
                  "text": "✏️ Edit",
                  "actionId": "edit_post",
                  "value": "={{ $json.post_id }}"
                }
              ]
            }
          ]
        },
        "otherOptions": {}
      },
      "id": "31aea874-516c-47c7-9c5f-bde873faae4d",
      "name": "Approval-on-Slack",
      "type": "n8n-nodes-base.slack",
      "position": [780, -180],
      "webhookId": "YOUR_SLACK_WEBHOOK_ID",
      "typeVersion": 2.3
    },
    {
      "parameters": {
        "jsCode": "// Extract the response from Slack\nconst body = $input.item.json.body || {};\nconst payload = typeof body.payload === 'string' ? JSON.parse(body.payload) : body.payload || {};\n\n// Get action details\nconst actions = payload.actions || [];\nconst action = actions[0] || {};\nconst actionId = action.action_id || '';\nconst postId = action.value || '';\n\n// Get the message text from Slack\nconst message = payload.message || {};\nconst messageText = message.text || '';\n\n// Extract the original post content from the message\nconst contentMatch = messageText.match(/\\*Generated Content:\\*\\n([\\s\\S]*?)\\n\\n(?:\\*Image URL:|\\*No image)/m);\nconst originalPost = contentMatch ? contentMatch[1].trim() : '';\n\n// Check if this is an edit action and get the edited content\nlet finalPost = originalPost;\n\nif (actionId === 'edit_post') {\n  // For edit actions, the user would provide edited content\n  // In a real scenario, you'd show a modal to edit - for now we use original\n  const stateValues = payload.state?.values || {};\n  const editedContent = Object.values(stateValues)[0]?.post_content?.value || originalPost;\n  finalPost = editedContent;\n}\n\n// Extract image URL from message\nconst imageMatch = messageText.match(/\\*Image URL:\\* (.+)$/m);\nconst imageUrl = imageMatch ? imageMatch[1].trim() : '';\n\nreturn {\n  json: {\n    action_id: actionId,\n    post_id: postId,\n    approved: actionId === 'approve_post',\n    edited_post: finalPost,\n    image_url: imageUrl,\n    original_post: originalPost\n  }\n};"
      },
      "id": "8592224a-0370-48c3-b803-fe3653284545",
      "name": "Format-Response",
      "type": "n8n-nodes-base.code",
      "position": [-260, -590],
      "typeVersion": 2
    },
