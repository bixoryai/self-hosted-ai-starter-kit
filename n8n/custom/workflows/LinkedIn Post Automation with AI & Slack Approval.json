    {
      "parameters": {
        "jsCode": "// Extract post ID and image URL from webhook payload\nconst body = $input.item.json.body || {};\nconst payload = typeof body.payload === 'string' ? JSON.parse(body.payload) : body.payload || {};\n\n// Get the post ID from button value\nconst actions = payload.actions || [];\nconst postId = actions[0]?.value || '';\n\n// Extract image URL from the message text\nconst message = payload.message || {};\nconst messageText = message.text || '';\nconst imageMatch = messageText.match(/\\*Image URL:\\* (.+)$/m);\nconst imageUrl = imageMatch ? imageMatch[1].trim() : '';\n\nreturn {\n  json: {\n    post_id: postId,\n    image_url: imageUrl\n  }\n};"
      },
